{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": true, // Make sure this is true
    "inlineSourceMap": false, // This should be false when sourceMap is true
    "inlineSources": false,
    "baseUrl": ".",
    "paths": {
      "@localTypes":["src/types/index.ts"],
      "@localTypes/*":["src/types/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
    ],
    "types": [
      "node",
      "express",
      "geojson"
    ]
  },
  "ts-node": {
    "files": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}